# Required: Lark custom bot webhook URL
# Format: https://open.feishu.cn/open-apis/bot/v2/hook/<uuid>
LARK_WEBHOOK_URL=

# Optional: Lark bot signing secret (security settings page in Lark bot admin)
# When set, gh2lark will auto-generate timestamp+sign for every message.
# Leave empty if you haven't enabled signature verification on the bot.
LARK_SIGNING_SECRET=

# Optional: GitHub webhook secret for HMAC-SHA256 payload validation
GITHUB_WEBHOOK_SECRET=

# Optional: Server listen port (default: 8080)
PORT=8080
